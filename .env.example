# Copia a ".env" (opcional: el servidor crea uno con DATA_KEY la primera vez).
# NUNCA subas .env ni la carpeta data/ a git.

PORT=3000
# 127.0.0.1 = solo esta máquina (lo más seguro). Usa 0.0.0.0 para abrirlo a la red local.
HOST=127.0.0.1

# Clave que cifra los datos clínicos en la base (64 caracteres hex). Se genera sola.
# Si la pierdes, los datos clínicos NO se pueden recuperar: guarda una copia aparte.
# DATA_KEY=

# Producción: activa cookies Secure y HSTS (requiere HTTPS delante, p. ej. Caddy/nginx).
# NODE_ENV=production
# Cantidad de proxies delante de la app (Caddy/nginx = 1).
# TRUST_PROXY=1

MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=15

# Copia este archivo como ".env" y coloca los datos reales de tu SQL Server
# cuando lo tengas disponible. Mientras tanto el backend arrancará igual,
# pero las rutas devolverán error 503 hasta que la conexión sea válida.

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=MediXCore
DB_USER=sa
DB_PASSWORD=TuPasswordAqui
# true si usas SQL Server en Azure, false para instancia local/on-premise
DB_ENCRYPT=false
# true si usas certificado autofirmado (típico en desarrollo local)
DB_TRUST_SERVER_CERTIFICATE=true

PORT=3000
CORS_ORIGIN=http://localhost:5173
